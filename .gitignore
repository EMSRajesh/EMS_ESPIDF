# ---------------------------------------------------------------------------
# MyEMS firmware repository — .gitignore (DP-WP4 milestone D0)
# ---------------------------------------------------------------------------

# ESP-IDF build trees (every mode: build_production, build_selftest,
# build_wp24_*, build_wp25_*, build_wp4_sim, build_host, ...)
/build/
/build_*/
managed_components/

# Active sdkconfig is generated by ESP-IDF. The named mode configurations
# (sdkconfig.production, sdkconfig.selftest, sdkconfig.wp24_*, ...) ARE tracked.
/sdkconfig
/sdkconfig.old

# Python
__pycache__/
*.pyc
.pytest_cache/

# Test evidence stays on disk (archive it separately), not in Git
tools/test_results/

# Editor / OS leftovers
*.bak
*.swp
.DS_Store
Thumbs.db
