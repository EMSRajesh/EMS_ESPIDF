{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myems.profile/1.1",
  "title": "MyEMS device profile (DP-WP4 Design v1.1 \u00a75, \u00a78.1)",
  "type": "object",
  "required": [
    "schema",
    "profile_id",
    "profile_version",
    "classification",
    "device_type",
    "vendor",
    "protocol",
    "register_map_ref",
    "comm_defaults",
    "capabilities",
    "conventions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "myems.profile/1.1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "classification": {
      "enum": [
        "PRODUCTION",
        "SIMULATION_ONLY",
        "TEST_ONLY"
      ]
    },
    "device_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "vendor": {
      "type": "object",
      "required": [
        "vendor_id",
        "model_number"
      ],
      "properties": {
        "vendor_id": {
          "type": "string"
        },
        "model_number": {
          "type": "string"
        },
        "protocol_document_reference": {
          "type": "string"
        },
        "hardware_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "firmware_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "datasheet_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "protocol": {
      "enum": [
        "MODBUS_RTU"
      ]
    },
    "register_map_ref": {
      "type": "object",
      "required": [
        "map_id",
        "map_version"
      ],
      "additionalProperties": false,
      "properties": {
        "map_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "map_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "comm_defaults": {
      "type": "object",
      "required": [
        "timeout_ms",
        "max_retries",
        "comm_lost_threshold",
        "probe_group",
        "probe_interval_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 50,
          "maximum": 5000
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "comm_lost_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "probe_group": {
          "type": "string"
        },
        "probe_interval_ms": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "conventions": {
      "type": "object",
      "required": [
        "power_sign",
        "pf_sign",
        "ratio_handling"
      ],
      "properties": {
        "power_sign": {
          "enum": [
            "IMPORT_POSITIVE"
          ]
        },
        "pf_sign": {
          "enum": [
            "SIGNED_BY_ACTIVE_POWER",
            "UNSIGNED"
          ]
        },
        "ratio_handling": {
          "enum": [
            "MYEMS_APPLIES",
            "METER_REPORTS_PRIMARY"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
