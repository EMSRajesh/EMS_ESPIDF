{
  "schema": "myems.umd/1.1",
  "umd_version": "1.1.0",
  "description": "MyEMS Universal Measurement Dictionary. Runtime IDs are permanent: never change or reuse one. Remove a parameter only by moving it to 'retired'. Roles and capabilities are host-side data (profile tool, simulator); released dictionaries are kept in config/umd/released/.",
  "domains": {
    "dev": "0x00",
    "ac": "0x01",
    "dc": "0x02",
    "pv": "0x03",
    "bat": "0x04",
    "pcs": "0x05"
  },
  "units": ["-", "V", "A", "kW", "kvar", "kVA", "1", "Hz", "kWh"],
  "value_types": ["float", "counter", "enum"],
  "roles": ["power.active", "power.reactive", "power.apparent", "power.factor", "current", "current.signed",
            "voltage", "frequency", "energy.import", "energy.export", "status"],
  "capabilities": {
    "phase_voltage":        ["ac.voltage.l1_n", "ac.voltage.l2_n", "ac.voltage.l3_n"],
    "phase_current":        ["ac.current.l1", "ac.current.l2", "ac.current.l3"],
    "active_power":         ["ac.power.active.total"],
    "reactive_power":       ["ac.power.reactive.total"],
    "apparent_power":       ["ac.power.apparent.total"],
    "power_factor":         ["ac.power.factor.total"],
    "frequency":            ["ac.frequency"],
    "active_energy_import": ["ac.energy.import.active"],
    "active_energy_export": ["ac.energy.export.active"],
    "device_status":        ["dev.status.code"],
    "power_quality":        [],
    "demand_measurement":   [],
    "dc_voltage":           ["dc.voltage"],
    "dc_current":           ["dc.current"],
    "dc_power":             ["dc.power"],
    "dc_energy_import":     ["dc.energy.import"],
    "dc_energy_export":     ["dc.energy.export"],
    "dc_shunt_temperature": []
  },
  "parameters": [
    { "id": "dev.status.code",         "runtime_id": "0x0001", "unit": "-",    "value_type": "enum",    "role": "status",        "description": "Raw device status word" },
    { "id": "ac.voltage.l1_n",         "runtime_id": "0x0101", "unit": "V",    "value_type": "float",   "role": "voltage",       "description": "Phase L1-N RMS voltage" },
    { "id": "ac.voltage.l2_n",         "runtime_id": "0x0102", "unit": "V",    "value_type": "float",   "role": "voltage",       "description": "Phase L2-N RMS voltage" },
    { "id": "ac.voltage.l3_n",         "runtime_id": "0x0103", "unit": "V",    "value_type": "float",   "role": "voltage",       "description": "Phase L3-N RMS voltage" },
    { "id": "ac.current.l1",           "runtime_id": "0x0111", "unit": "A",    "value_type": "float",   "role": "current",       "description": "Phase L1 RMS current" },
    { "id": "ac.current.l2",           "runtime_id": "0x0112", "unit": "A",    "value_type": "float",   "role": "current",       "description": "Phase L2 RMS current" },
    { "id": "ac.current.l3",           "runtime_id": "0x0113", "unit": "A",    "value_type": "float",   "role": "current",       "description": "Phase L3 RMS current" },
    { "id": "ac.power.active.total",   "runtime_id": "0x0121", "unit": "kW",   "value_type": "float",   "role": "power.active",  "description": "Total active power, import positive" },
    { "id": "ac.power.reactive.total", "runtime_id": "0x0122", "unit": "kvar", "value_type": "float",   "role": "power.reactive", "description": "Total reactive power" },
    { "id": "ac.power.apparent.total", "runtime_id": "0x0123", "unit": "kVA",  "value_type": "float",   "role": "power.apparent","description": "Total apparent power" },
    { "id": "ac.power.factor.total",   "runtime_id": "0x0124", "unit": "1",    "value_type": "float",   "role": "power.factor",  "description": "Total power factor, sign follows active power" },
    { "id": "ac.frequency",            "runtime_id": "0x0130", "unit": "Hz",   "value_type": "float",   "role": "frequency",     "description": "System frequency" },
    { "id": "ac.energy.import.active", "runtime_id": "0x0140", "unit": "kWh",  "value_type": "counter", "role": "energy.import", "description": "Cumulative imported active energy" },
    { "id": "ac.energy.export.active", "runtime_id": "0x0141", "unit": "kWh",  "value_type": "counter", "role": "energy.export", "description": "Cumulative exported active energy" },
    { "id": "dc.voltage",              "runtime_id": "0x0201", "unit": "V",    "value_type": "float",   "role": "voltage",        "description": "DC bus voltage at the meter" },
    { "id": "dc.current",              "runtime_id": "0x0211", "unit": "A",    "value_type": "float",   "role": "current.signed", "description": "DC current, positive in the reference direction" },
    { "id": "dc.power",                "runtime_id": "0x0221", "unit": "kW",   "value_type": "float",   "role": "power.active",   "description": "DC power, positive in the reference direction" },
    { "id": "dc.energy.import",        "runtime_id": "0x0240", "unit": "kWh",  "value_type": "counter", "role": "energy.import",  "description": "Cumulative DC energy in the reference direction" },
    { "id": "dc.energy.export",        "runtime_id": "0x0241", "unit": "kWh",  "value_type": "counter", "role": "energy.export",  "description": "Cumulative DC energy against the reference direction" }
  ],
  "retired": []
}
